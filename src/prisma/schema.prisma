generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  EDITOR
}

enum ExperienceType {
  CAFE
  BREW_HOUSE
  SHARED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SectionType {
  HERO
  IMAGE_TEXT
  FULL_IMAGE
  VIDEO
  GALLERY
  MENU_HIGHLIGHTS
  BREW_SHOWCASE
  EVENT_SHOWCASE
  OFFER
  TESTIMONIALS
  ANNOUNCEMENT
  CTA
  SPLIT_IMAGE_TEXT
  CUSTOM_CONTENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default("global")
  businessName String
  address      String
  phone        String
  whatsapp     String
  email        String
  openingHours String @db.Text
  socialLinks  Json   // { instagram: string, facebook: string, ... }
  mapsUrl      String
  footerContent String @db.Text
  updatedAt    DateTime @updatedAt
}

model SEOSetting {
  id          String   @id @default("global")
  title       String
  description  String   @db.Text
  keywords     String   @db.Text
  ogImage     String?
  canonicalUrl String?
}

model PageSection {
  id          String      @id @default(cuid())
  type        SectionType
  title       String?
  content     Json        // Dynamic content based on type
  order       Int
  isVisible   Boolean     @default(true)
  isDraft     Boolean     @default(false)
  experience  ExperienceType @default(SHARED)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Media {
  id          String   @id @default(cuid())
  url         String
  type        String   // 'image' | 'video'
  altText     String?
  caption     String?
  folder      String?
  experience  ExperienceType @default(SHARED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String
  order     Int
  experience ExperienceType @default(SHARED)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id          String       @id @default(cuid())
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String?      @db.Text
  price       Decimal      @db.Decimal(10, 2)
  image       String?
  isFeatured  Boolean      @default(false)
  isAvailable Boolean      @default(true)
  experience  ExperienceType @default(SHARED)
  dietaryTags String?      // e.g., "Veg, Vegan, Gluten-Free"
  allergens   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Brew {
  id          String   @id @default(cuid())
  name        String
  style       String
  description String?  @db.Text
  abv         String
  ibu         String?
  tastingNotes String?  @db.Text
  image       String?
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  experience  ExperienceType @default(BREW_HOUSE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  time        String
  description String?  @db.Text
  artist      String?
  image       String?
  category    String?
  experience  ExperienceType @default(SHARED)
  bookingInfo String?  @db.Text
  ticketLink  String?
  status      String    @default("UPCOMING") // UPCOMING, LIVE, PAST, CANCELLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Offer {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  image       String?
  value       String   // e.g., "20% Off"
  terms       String?  @db.Text
  startDate   DateTime
  endDate     DateTime
  experience ExperienceType @default(SHARED)
  cta         String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Reservation {
  id          String            @id @default(cuid())
  customerName String
  phone       String
  email       String
  date        DateTime
  time        String
  guestCount  Int
  requests    String?           @db.Text
  status      ReservationStatus @default(PENDING)
  experience  ExperienceType @default(SHARED)
  reservationId String          @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model BusinessHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0-6
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  name      String
  content   String   @db.Text
  rating    Int
  source      String?  // "Google", "TripAdvisor", etc.
  experience ExperienceType @default(SHARED)
  date        DateTime @default(now())
  isFeatured Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  details   Json
  timestamp DateTime @default(now())
}
